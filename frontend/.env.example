# AURA Social Network Environment Configuration

# Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# Example: 1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Backend API Base URL (For Phase 2 / Production REST API integration)
VITE_API_BASE_URL=http://localhost:5000/api/v1
